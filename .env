# Read by the Prisma CLI (`prisma migrate`, `prisma db seed`, `prisma studio`).
# Next.js itself reads .env.local — keep DATABASE_URL identical in both files.
DATABASE_URL="postgresql://postgres:password@localhost:5432/zeem_db"

# Direct (non-pooled) connection used by `prisma migrate`. On a local
# PostgreSQL keep it identical to DATABASE_URL. On Neon/Supabase set it to the
# UNPOOLED connection string — migrations fail through a transaction pooler.
DIRECT_URL="postgresql://postgres:password@localhost:5432/zeem_db"
