# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env — .env and .env.local are committed with placeholder values only
# (.env is what the Prisma CLI reads; .env.local is what Next.js reads).
# Replace them per-environment; never commit real secrets.
.env.production
.env*.real

# uploads (local dev file storage)
/public/uploads/*
!/public/uploads/.gitkeep

# prisma
/prisma/migrations/dev.db*

# typescript
*.tsbuildinfo
