# ======================================================================
# Zeem Marketplace — environment configuration (placeholder values).
# Replace every value before deploying. Never commit real secrets.
# ======================================================================

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zeem?schema=public"

# NextAuth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-32-byte-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — Google login is enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta (Facebook) Pixel — server-side Conversions API (optional)
META_PIXEL_ID=""
META_ACCESS_TOKEN=""

# Pusher — realtime updates (optional; realtime is a no-op when unset)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
