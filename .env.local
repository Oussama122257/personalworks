# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/zeem_db"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL locally;
# the UNPOOLED string on Neon/Supabase.
DIRECT_URL="postgresql://postgres:password@localhost:5432/zeem_db"

# Authentication
NEXTAUTH_SECRET="your-nextauth-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: OpenAI for AI features
OPENAI_API_KEY="sk-..."

# ----------------------------------------------------------------------
# Optional integrations (features no-op gracefully when unset)
# ----------------------------------------------------------------------
# Google OAuth
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Meta (Facebook) Pixel — server-side Conversions API
# META_PIXEL_ID=""
# META_ACCESS_TOKEN=""
# Pusher — realtime dashboard updates
# PUSHER_APP_ID=""
# PUSHER_SECRET=""
# NEXT_PUBLIC_PUSHER_KEY=""
# NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Encryption key for stored courier credentials.
# Falls back to NEXTAUTH_SECRET when unset. Rotating it makes previously
# stored API keys undecryptable — sellers must re-enter them.
# ENCRYPTION_KEY=""

# Email / SMS providers. Without these, notifications are logged server-side
# and reported as undelivered rather than silently dropped.
# EMAIL_API_URL=""
# EMAIL_API_KEY=""
# EMAIL_FROM="no-reply@zeem.dz"
# SMS_API_URL=""
# SMS_API_KEY=""
# SMS_SENDER="ZEEM"

# Courier APIs — used by the health monitor and the seller "Test Connection"
# button. Unset endpoints report "not configured" instead of a false success.
# YALIDINE_API_URL=""
# YALIDINE_API_KEY=""
# ZR_EXPRESS_API_URL=""
# ZR_EXPRESS_API_KEY=""
# POSTE_API_URL=""
# POSTE_API_KEY=""

# Shared secret for scheduled jobs (courier health, support escalation).
# Send it as the x-cron-secret header.
# CRON_SECRET=""
# SUPPORT_ESCALATION_HOURS="24"
