// Zeem Marketplace — PostgreSQL schema (Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  seller
  wilaya_manager
  accountant
  agent
  buyer
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ShippingProvider {
  ZEEM_DEFAULT
  YALIDINE
  ZR_EXPRESS
  POSTE
  CUSTOM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  COD
  CIB
  EDAHABIA
}

enum ShipmentStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED_COD_COLLECTED
  FAILED_DELIVERY
  RETURNED
}

enum TransactionType {
  COMMISSION_OWNER
  COMMISSION_MANAGER
  PAYOUT
  SHIPPING_FEE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PointsTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

// ---------------------------------------------------------------------------
// Users & geography
// ---------------------------------------------------------------------------

model Profile {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  fullName     String
  avatarUrl    String?
  role         Role     @default(buyer)
  // Wilaya of responsibility for wilaya_manager / agent roles
  wilayaCode   Int?
  wilaya       Wilaya?  @relation(fields: [wilayaCode], references: [code])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores             Store[]              @relation("StoreOwner")
  approvedStores     Store[]              @relation("StoreApprover")
  orders             Order[]              @relation("BuyerOrders")
  assignedShipments  Shipment[]           @relation("AgentShipments")
  transactions       Transaction[]
  loyaltyPoints      LoyaltyPoints?
  pointsTransactions PointsTransaction[]
  auditLogs          AuditLog[]
  reviews            Review[]

  @@index([role])
  @@map("profiles")
}

model Wilaya {
  code     Int     @id
  nameFr   String
  nameAr   String
  // Shipping pricing zone: 1 (north) .. 4 (deep south)
  zone     Int     @default(1)
  isActive Boolean @default(true)

  communes      Commune[]
  stores        Store[]
  profiles      Profile[]
  orders        Order[]
  shippingRates ShippingRate[]

  @@map("wilayas")
}

model Commune {
  id         String  @id @default(cuid())
  name       String
  nameAr     String?
  postalCode String?
  wilayaCode Int
  wilaya     Wilaya  @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)

  orders Order[]

  @@unique([wilayaCode, name])
  @@map("communes")
}

// ---------------------------------------------------------------------------
// Stores & catalog
// ---------------------------------------------------------------------------

model Store {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  logoUrl        String?
  ownerId        String
  owner          Profile          @relation("StoreOwner", fields: [ownerId], references: [id])
  wilayaCode     Int
  wilaya         Wilaya           @relation(fields: [wilayaCode], references: [code])
  status         StoreStatus      @default(PENDING)
  // Platform commission (%) applied on each delivered order
  commissionRate Decimal          @default(5) @db.Decimal(5, 2)
  // Seller's withdrawable balance in DZD
  balance        Decimal          @default(0) @db.Decimal(14, 2)
  // Shipping configuration: platform default vs. seller's own carrier keys
  shippingProvider ShippingProvider @default(ZEEM_DEFAULT)
  shippingApiKey   String?
  approvedById   String?
  approvedBy     Profile?         @relation("StoreApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  products     Product[]
  orders       Order[]
  transactions Transaction[]

  @@index([wilayaCode, status])
  @@map("stores")
}

model Product {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String
  slug              String   @unique
  description       String?
  category          String   @default("General")
  images            String[] @default([])
  basePrice         Decimal  @db.Decimal(12, 2)
  isPublished       Boolean  @default(true)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants ProductVariant[]
  reviews  Review[]

  @@index([storeId])
  @@index([category])
  @@map("products")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String  @unique
  name          String
  size          String?
  color         String?
  price         Decimal @db.Decimal(12, 2)
  stockQuantity Int     @default(0)

  orders Order[]

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Orders & fulfillment
// ---------------------------------------------------------------------------

model Order {
  id            String         @id @default(cuid())
  reference     String         @unique
  // Registered buyer (nullable: guest fast-orders)
  buyerId       String?
  buyer         Profile?       @relation("BuyerOrders", fields: [buyerId], references: [id])
  guestName     String?
  phone         String
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  totalAmount   Decimal        @db.Decimal(14, 2)
  shippingFee   Decimal        @default(0) @db.Decimal(12, 2)
  wilayaCode    Int
  wilaya        Wilaya         @relation(fields: [wilayaCode], references: [code])
  communeId     String
  commune       Commune        @relation(fields: [communeId], references: [id])
  address       String
  status        OrderStatus    @default(PENDING)
  paymentMethod PaymentMethod  @default(COD)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shipment           Shipment?
  transactions       Transaction[]
  pointsTransactions PointsTransaction[]
  reviews            Review[]

  @@index([storeId, status])
  @@index([wilayaCode])
  @@index([createdAt])
  @@map("orders")
}

model Shipment {
  id              String           @id @default(cuid())
  orderId         String           @unique
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber  String           @unique
  provider        ShippingProvider @default(ZEEM_DEFAULT)
  status          ShipmentStatus   @default(PENDING_PICKUP)
  agentId         String?
  agent           Profile?         @relation("AgentShipments", fields: [agentId], references: [id])
  // Cash to collect on delivery (goods + shipping)
  codAmount       Decimal          @db.Decimal(14, 2)
  collectedAmount Decimal?         @db.Decimal(14, 2)
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  failureReason   String?
  lastLat         Float?
  lastLng         Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  locationUpdates DeliveryLocationUpdate[]

  @@index([agentId, status])
  @@index([status])
  @@map("shipments")
}

model DeliveryLocationUpdate {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  note       String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
  @@map("delivery_location_updates")
}

model ShippingRate {
  id                String           @id @default(cuid())
  provider          ShippingProvider
  wilayaCode        Int
  wilaya            Wilaya           @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  homeDeliveryPrice Decimal          @db.Decimal(10, 2)
  stopDeskPrice     Decimal          @db.Decimal(10, 2)
  returnPrice       Decimal          @default(0) @db.Decimal(10, 2)
  estimatedDays     Int              @default(3)
  isActive          Boolean          @default(true)

  @@unique([provider, wilayaCode])
  @@map("shipping_rates")
}

// ---------------------------------------------------------------------------
// Money, loyalty, trust
// ---------------------------------------------------------------------------

model Transaction {
  id          String            @id @default(cuid())
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  amount      Decimal           @db.Decimal(14, 2)
  currency    String            @default("DZD")
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id])
  storeId     String?
  store       Store?            @relation(fields: [storeId], references: [id])
  // Beneficiary profile (e.g. the wilaya manager for COMMISSION_MANAGER)
  profileId   String?
  profile     Profile?          @relation(fields: [profileId], references: [id])
  description String?
  createdAt   DateTime          @default(now())

  @@index([type, status])
  @@index([storeId])
  @@index([createdAt])
  @@map("transactions")
}

model LoyaltyPoints {
  id             String   @id @default(cuid())
  profileId      String   @unique
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("loyalty_points")
}

model PointsTransaction {
  id          String                @id @default(cuid())
  profileId   String
  profile     Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?                @relation(fields: [orderId], references: [id])
  type        PointsTransactionType
  points      Int
  description String?
  createdAt   DateTime              @default(now())

  @@index([profileId])
  @@map("points_transactions")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Profile? @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  authorId  String?
  author    Profile? @relation(fields: [authorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}
